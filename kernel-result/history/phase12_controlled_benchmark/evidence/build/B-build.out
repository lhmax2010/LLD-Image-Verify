AR=llvm-ar
BUILD_dm_bow=m
BUILD_extcon_usb_fixed=m
BUILD_inform_reboot=m
BUILD_kdbus=m
BUILD_logger=m
BUILD_proc_tsm=m
BUILD_zlogger=m
CC=armv7l-tizen-linux-gnueabi-clang
CXX=armv7l-tizen-linux-gnueabi-clang++
HOME=/home/abuild
LC_ALL=C
LLVM=1
LOGGER_EVENTS_BUFFER_SIZE=256
LOGGER_MAIN_BUFFER_SIZE=256
LOGGER_RADIO_BUFFER_SIZE=256
LOGGER_SYSTEM_BUFFER_SIZE=256
MAKEFLAGS=-j1 -k
PATH=/mnt/entry:/usr/sbin:/usr/bin:/sbin:/bin
PWD=/home/abuild/rpmbuild/BUILD/linux-tizen-modules-11.0.0
RANLIB=llvm-ranlib
SHLVL=1
THREAD_GROUP_CPUTIME_SUPPORT=1
TIZEN_INFORM_PATH=/mnt/inform/reboot-param.bin
TMPDIR=/tmp
TZ=UTC
V=1
